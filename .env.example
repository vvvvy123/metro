# Copy to `.env` (which is gitignored) and fill in. Nothing here is secret.
#
# Local development needs NONE of this: with no .env at all, the app runs on
# SQLite (metro.db) exactly as before, with zero third-party dependencies.

# Postgres connection string. Setting this switches the whole app to Postgres.
# Use Neon's POOLED endpoint — note the `-pooler` in the hostname. The direct
# endpoint opens a new backend per connection, which a serverless function will
# exhaust quickly.
#   postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: point at a different SQLite file (used by tests against a copy).
# DB_PATH=

# Optional: bind address / port for the local dev server.
# HOST=127.0.0.1
# PORT=8000
